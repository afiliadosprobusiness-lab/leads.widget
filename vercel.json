{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/crm/(contacts-merge|deals|tasks|timeline)",
      "dest": "/api/crm?resource=$1"
    },
    {
      "src": "/api/admin/create-client",
      "dest": "/api/debug?adminAction=create-client"
    },
    {
      "src": "/api/admin/whatsapp-crm-sync",
      "dest": "/api/debug?adminAction=whatsapp-crm-sync"
    },
    {
      "src": "/api/admin/whatsapp-crm-status-batch",
      "dest": "/api/debug?adminAction=whatsapp-crm-status-batch"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://api-production-dced.up.railway.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
