# Optional: Cloudinary storage for welcome media uploads in Dashboard
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional override for external backend base URL used by Vercel API proxies.
# Keep empty in local dev unless you want /api/* to target a deployed backend.
BACKEND_URL=

# Required for secure local storage of Meta CAPI access tokens in /api/meta-capi-config
META_CAPI_ENCRYPTION_KEY=

# Optional override for Meta Graph API version used by CAPI dispatch
META_GRAPH_API_VERSION=v22.0

# DNI validation for VALIDAR_DNI command in /api/chat
# Strategy:
# - auto (default): tries external API first (if configured), then ELDNI fallback
# - api: only external API
# - eldni: only public ELDNI form
# - capture: does not validate externally, only receives DNI and continues flow
DNI_VALIDATION_PROVIDER=auto
ELDNI_FORM_URL=https://eldni.com/pe/buscar-por-dni
ELDNI_TIMEOUT_MS=9000

# Optional external DNI API (recommended for production reliability)
# Supports URL with {dni} placeholder, or query param style.
DNI_API_URL=
DNI_API_METHOD=GET
DNI_API_DNI_QUERY_PARAM=dni
DNI_API_DNI_BODY_FIELD=dni
DNI_API_TOKEN=
DNI_API_TOKEN_HEADER=Authorization
DNI_API_TOKEN_PREFIX=Bearer
DNI_API_TIMEOUT_MS=9000
# Optional JSON path to resolve object inside response (example: data.persona)
DNI_API_RESPONSE_PATH=

# Optional server-to-server sync to WhatsApp CRM Extension subscription
# Used by superadmin toggle in /superadmin -> CRM WhatsApp tab.
WHATSAPP_CRM_SYNC_URL=https://whats-crm-compliant.vercel.app/api/v1/admin/sync-subscription
WHATSAPP_CRM_SYNC_KEY=
WHATSAPP_CRM_STATUS_URL=https://whats-crm-compliant.vercel.app/api/v1/admin/subscriptions-by-email
