# Optional: Cloudinary storage for welcome media uploads in Dashboard
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Required for secure local storage of Meta CAPI access tokens in /api/meta-capi-config
META_CAPI_ENCRYPTION_KEY=

# Optional override for Meta Graph API version used by CAPI dispatch
META_GRAPH_API_VERSION=v22.0

# DNI validation for VALIDAR_DNI command in /api/chat (ELDNI only)
# DNI_VALIDATION_PROVIDER is kept for backward compatibility but runtime enforces ELDNI source.
DNI_VALIDATION_PROVIDER=eldni
ELDNI_FORM_URL=https://eldni.com/pe/buscar-por-dni
ELDNI_TIMEOUT_MS=9000
