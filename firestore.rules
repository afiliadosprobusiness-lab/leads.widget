rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user has superadmin role in user_roles collection OR matches specific emails
    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'superadmin') ||
        request.auth.token.email == 'afiliadosprobusiness@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isDocOwner(docData) {
      return request.auth != null && docData.user_id == request.auth.uid;
    }

    function isLeadOwner(docData) {
      return request.auth != null && docData.client_id == request.auth.uid;
    }

    function hasLegacyCustomTrackingCode(docData) {
      return ('custom_tracking_code' in docData) || ('custom_code' in docData);
    }
    
    // User Roles - Highly sensitive
    match /user_roles/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }
    
    // Profiles
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      // User deletion is handled only by the backend (Admin SDK). This also protects superadmins.
      allow delete: if false;
    }
    
    // Widget Configs
    match /widget_configs/{configId} {
      allow read: if true; // Public for the widget to load
      allow create, update: if request.auth != null
        && (isDocOwner(request.resource.data) || isSuperAdmin())
        && !hasLegacyCustomTrackingCode(request.resource.data);
      allow delete: if false;
    }
    
    // Leads
    match /leads/{leadId} {
      allow read: if request.auth != null && (isLeadOwner(resource.data) || isSuperAdmin());
      allow create: if true; // Public for widget script
      allow update, delete: if request.auth != null && (isLeadOwner(resource.data) || isSuperAdmin());
    }

    // CRM Contacts
    match /crm_contacts/{contactId} {
      allow read: if request.auth != null && (isLeadOwner(resource.data) || isSuperAdmin());
      allow create: if request.auth != null
        && (request.resource.data.client_id == request.auth.uid || isSuperAdmin());
      allow update, delete: if request.auth != null && (isLeadOwner(resource.data) || isSuperAdmin());
    }

    // Blocked IPs
    match /blocked_ips/{ipId} {
      allow read: if true; // Widget needs to check this
      allow create: if true; // API/Widget can block
      allow delete: if request.auth != null; // Owners/Admins can unblock
    }
    
    // Analytics
    match /analytics/{analyticsId} {
      allow read: if request.auth != null; // Simplified list access
      allow create: if true; // Public tracking
      allow delete: if isSuperAdmin();
    }

    // AI Chat Logs (written by server-side proxy)
    match /ai_chat_logs/{logId} {
      allow read: if request.auth != null && (isLeadOwner(resource.data) || isSuperAdmin());
      allow create, update, delete: if false;
    }

    // AI Chat Events (written by server-side proxy)
    match /ai_chat_events/{eventId} {
      allow read: if request.auth != null && (isLeadOwner(resource.data) || isSuperAdmin());
      allow create, update, delete: if false;
    }

    // Visits (New Analytics Tracking)
    match /visits/{visitId} {
      allow create: if true; // Public for widget tracking
      allow read: if request.auth != null; // Dashboard can read
      allow update, delete: if request.auth != null; // Manage visits if needed
    }
    
    // Payments
    match /payments/{paymentId} {
      allow read: if request.auth != null && (isDocOwner(resource.data) || isSuperAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // Partner Program (server-side scoped via backend, restricted on direct client access)
    match /partners/{partnerId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /partner_users/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /partner_invites/{inviteId} {
      allow read, write: if isSuperAdmin();
    }

    match /partner_checkout_links/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /partner_leads/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /partner_client_drafts/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /partner_tickets/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /partner_payouts/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /commission_ledger/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /audit_events/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // System Settings (Global Config like Landing Widget ID)
    match /system_settings/{docId} {
      allow read: if true; // Public for Landing Page
      allow write: if isSuperAdmin(); // Only SuperAdmin controls this
    }
  }
}
